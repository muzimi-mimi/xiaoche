# 安装介质与临时探针(不入库)
.ps7-install/
*.msi
_probe*.bin
_sp_trace.txt

# 系统杂项
Thumbs.db
desktop.ini
~$*

# Keil 编译中间产物(保留 hex/map/构建日志)
keil_PID/MDK-ARM/PID/*
!keil_PID/MDK-ARM/PID/PID.hex
!keil_PID/MDK-ARM/PID/PID.map
!keil_PID/MDK-ARM/PID/PID.build_log.htm
keil_PID/MDK-ARM/*.uvguix.*
.zcode/

# 工程副本与临时草稿(不入库)
keil_PID - 副本/
gmr_tmp/

# 源码的临时备份(不入库)
keil_PID/Core/Src/*.bak
keil_PID/Core/Src/*.bak-*
keil_PID/Core/Src/*.bak_*
keil_PID/Core/Inc/*.bak
main.c.bak_*
main.c.GBK_GOOD_*
/main_K.c
/main_T.c

# VSCode / STM32 VS Code 扩展生成物(2026-10-30 起不再使用 VSCode, 不入库)
# 文件仍保留在磁盘上, 只是不纳入版本控制; 将来想恢复命令行 gcc 构建时删掉本节即可
keil_PID/.vscode/
keil_PID/.settings/
keil_PID/.clangd
keil_PID/CMakeLists.txt
keil_PID/CMakePresets.json
keil_PID/cmake/
keil_PID/startup_stm32f103xb.s
keil_PID/STM32F103xx_FLASH.ld
keil_PID/Core/Src/syscalls.c
keil_PID/Core/Src/sysmem.c
keil_PID/build/
keil_PID/mx.scratch/

# 临时分析脚本与草稿(不入库)
/work/
/a-main.su
/tp.c
