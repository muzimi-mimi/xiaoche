/* ==========================================================================
 * PID 状态复位 / 倾角重对准
 *
 * PID_ResetAll()：把三个环的 Target / Out / 积分 / 误差全部清零，并把"上次值"
 *   重新播种为当前传感器读数，避免下一轮微分项第一次冲击。
 *   倾倒(StopCar)、急停 "0"、起立超时都会经过 StopCar，顺带清干净。
 *   函数体内只有浮点赋值和全局变量读取，可以从 1ms 中断里安全快速调用。
 *
 * Angle_Realign()：用加速度计把倾角重新对准一次(静止时可信)。
 *   互补滤波 Alpha=0.001，时间常数约 10s：摔倒时陀螺饱和会把 Angle 积到
 *   偏离真实值很远，若不重对准，按 "1" 后可能因为 |Angle| 误报成很小而直接
 *   跳进 BALANCE —— 车还躺着，程序却以为已经站起来了。
 *   内含 30 x 10ms = 300ms 的 HAL_Delay，只能在主循环调用，
 *   绝对不能放进 1ms 的 HAL_TIM_PeriodElapsedCallback。
 * ========================================================================== */
void PID_ResetAll(void)
{
    PID_Init(&AnglePID);
    PID_Init(&SpeedPID);
    PID_Init(&TurnPID);

    /* 预置"上次值"，防止微分项第一次冲击 */
    AnglePID.Actual  = Angle;
    AnglePID.Actual1 = Angle;
    AnglePID.Error0  = AnglePID.Target - AnglePID.Actual;
    AnglePID.Error1  = AnglePID.Error0;

    SpeedPID.Actual  = AveSpeed;
    SpeedPID.Actual1 = AveSpeed;
    TurnPID.Actual   = DifSpeed;
    TurnPID.Actual1  = DifSpeed;

    DifSpeedFilter = DifSpeed;
    DifPWM         = 0;
}

void Angle_Realign(void)
{
    int32_t  sum = 0;
    int      k;
    uint32_t itWasOn;

    /* 采样期间屏蔽 TIM3 中断：中断里也会读 MPU6050(同一条 I2C)，
     * 并发访问会互相破坏采样。只动 DIER 的 UIE 位，启动状态保持原样，
     * 所以上电初始化和运行中调用都适用。 */
    itWasOn = (htim3.Instance->DIER & TIM_IT_UPDATE) ? 1u : 0u;
    __HAL_TIM_DISABLE_IT(&htim3, TIM_IT_UPDATE);

    for (k = 0; k < 30; k++)              /* 30 x 10ms = 300ms */
    {
        MPU6050_GetData(&AX, &AY, &AZ, &GX, &GY, &GZ);
        sum += (int32_t)(-atan2(AY, AZ) / 3.14159 * 180.0);
        HAL_Delay(10);
    }

    Angle = (float)sum / 30.0f + G;       /* 取平均，抑制振动噪声 */

    if (itWasOn)
    {
        __HAL_TIM_CLEAR_IT(&htim3, TIM_IT_UPDATE);
        __HAL_TIM_ENABLE_IT(&htim3, TIM_IT_UPDATE);
    }
}

/* ==========================================================================
 * 状态机动作：StartErect() / StopCar()
 * StartErect() 只在主循环（蓝牙解析处）调用；StopCar() 主循环和 10ms 中断
 * 都会调用，它只做赋值、PID 复位和 GPIO 写，可以从中断里安全调用。
 * CarState 一律最后写：中断只会看到"旧状态"或"新状态已就绪"两种，
 * 所以不需要额外的临界区。
 * ========================================================================== */
void StopCar(void)
{
    CarState  = ST_IDLE;
    ErectTime = 0;
    PID_ResetAll();               /* 倾倒/急停/超时：三个环的内部状态一起清干净 */
    TB6612_setPWM(1, 0);          /* 停：PWM=0，IN1/IN2 同向 -> 电机滑行 */
    TB6612_setPWM(2, 0);
}

void StartErect(void)
{
    if (CarState != ST_IDLE)
    {
        return;                   /* 起立中或已直立：忽略重复的 "1" */
    }

    /* 先重对准倾角，再交给自起立：躺倒后按 "1" 拿到的是真实倾角，
     * 而不是漂掉的陀螺积分值。300ms 阻塞，只在主循环里跑。 */
    Angle_Realign();

    PID_ResetAll();
    ErectTime = 0;

    CarState = ST_ERECT;          /* 最后一步：从中断视角看是原子的 */
}

static const char *StateStr(void)
{
    if (CarState == ST_BALANCE) return "BAL";
    if (CarState == ST_ERECT)   return "ERECT";
    return "IDLE";
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim != &htim3)
    {
        return;
    }

    hcount++;
    __HAL_TIM_CLEAR_IT(&htim3, TIM_IT_UPDATE);

    if (hcount >= 10)
    {
        hcount = 0;
        MPU6050_GetData(&AX, &AY, &AZ, &GX, &GY, &GZ);
        /* 陀螺仪Y轴零漂，按实际硬件调整 */
        GX += 10;

        AngleAcc = -atan2(AY, AZ) / 3.14159 * 180 + G;

        /* 互补滤波 */
        AngleGyro = Angle - GX / 32768.0 * 2000 * 0.01;
        float Alpha = 0.001f;
        Angle = Alpha * AngleAcc + (1 - Alpha) * AngleGyro;

        /* ---------- 偏航角：Z轴陀螺积分 ----------
         * 移植自参考工程 24.STM32-MPU6050，三处必要改动：
         *   1) 量程：本工程 GYRO_CONFIG=0x18(±2000°/s) → 16.384 LSB/(°/s)；
         *      参考工程是 0x00(±250°/s) 的 131。直接照抄 131 会让偏航角大 8 倍。
         *   2) dt 固定 0.01f：控制周期恒定，比参考工程 HAL_GetTick() 的 1ms 分辨率更准。
         *   3) float 而非 double：Cortex-M3 无 FPU，double 除法约贵 5 倍。 */
        YawRate = GZ / YAW_LSB_PER_DPS - YAW_BIAS_DPS;
        if (YawRate > -YAW_DEADZONE_DPS && YawRate < YAW_DEADZONE_DPS) YawRate = 0.0f;
        Yaw += YawRate * YAW_DT;
#if YAW_WRAP
        if      (Yaw >  180.0f) Yaw -= 360.0f;
        else if (Yaw < -180.0f) Yaw += 360.0f;
#endif

        /* ================= 控制分派：三态互斥 ================= */
        if (CarState == ST_BALANCE)
        {
            /* ---------- 正常直立：原平衡环 ---------- */
            AnglePID.Actual = Angle;
            PID_Update(&AnglePID);
            AvePWM = -AnglePID.Out;

            LeftPWM  = AvePWM + DifPWM / 2;
            RightPWM = AvePWM - DifPWM / 2;

            if (LeftPWM > 80)        LeftPWM  = 80;
            else if (LeftPWM < -80)  LeftPWM  = -80;
            if (RightPWM > 80)       RightPWM = 80;
            else if (RightPWM < -80) RightPWM = -80;

            TB6612_setPWM(1, LeftPWM);
            TB6612_setPWM(2, RightPWM);
        }
        else if (CarState == ST_ERECT)
        {
            /* ---------- 自起立：两轮同向给大 PWM，靠反扭矩把车身甩回竖直 ----------
             * 方向与平衡环一致：Angle>0 往前甩，Angle<0 往后甩。
             * 后仰比前倾更难甩起来，所以成功窗口按方向分别判定。 */
            float erectDoneAng = (Angle > 0.0f) ? ERECT_DONE_ANG : ERECT_DONE_ANG_BACK;

            if (fabsf(Angle) <= erectDoneAng)
            {
                /* 已进入可平衡范围 -> 交回平衡环 */
                PID_ResetAll();
                ErectTime = 0;
                CarState  = ST_BALANCE;
            }
            else if (ErectTime < ERECT_TIMEOUT_MS)
            {
                int16_t swing = (Angle > 0.0f) ? ERECT_PWM : -ERECT_PWM;
                if (ERECT_DIR < 0) swing = -swing;      /* 方向不对就取反 */

                if (ERECT_PULSE_MS > 0 && (ErectTime % ERECT_PERIOD_MS) >= ERECT_PULSE_MS)
                    swing = 0;                          /* 脉冲(踢)模式：到点断电，靠惯性甩上去 */

                /* 防自转：起立过程不响应摇杆，只把左右轮速差拉回 0 */
                TurnPID.Target = 0.0f;
                TurnPID.Actual = DifSpeed;
                PID_Update(&TurnPID);
                DifPWM = (int16_t)TurnPID.Out;

                LeftPWM  = swing + DifPWM / 2;
                RightPWM = swing - DifPWM / 2;

                if (LeftPWM > 100)        LeftPWM  = 100;
                else if (LeftPWM < -100)  LeftPWM  = -100;
                if (RightPWM > 100)       RightPWM = 100;
                else if (RightPWM < -100) RightPWM = -100;

                TB6612_setPWM(1, LeftPWM);
                TB6612_setPWM(2, RightPWM);
                ErectTime += 10;                        /* 本段每 10ms 进一次 */
            }
            else
            {
                /* ---------- 超时仍起不来（轮子离地/打滑/被卡住）：停机 ----------
                 * 退回 IDLE，再发一次 "1" 即可重试。 */
                StopCar();
            }
        }
        else
        {
            /* ---------- ST_IDLE：上电默认，电机断电 ----------
             * 每 10ms 反复置 0，是自愈式的：任何意外的残留 PWM 都会被清掉。 */
            TB6612_setPWM(1, 0);
            TB6612_setPWM(2, 0);
        }
    }

    Count1 ++;				//计次自增

    if (Count1 >= 50)		//如果计次50次，则if成立，即if每隔50ms进一次
    {
        Count1 = 0;			//计次清零，便于下次计数

        /*编码器磁铁旋转一圈，计次增量为44，编码器读取间隔是50ms（0.05s）*/
        /*因此磁铁旋转速度 = 计次增量 / 44 / 0.05，单位是转每秒*/
        LeftSpeed = ReadSpeed(&htim2) / 44.0 / 0.05 / 30;
        RightSpeed = -ReadSpeed(&htim4) / 44.0 / 0.05 / 30;

        /*信号量转换*/
			AveSpeed = (LeftSpeed + RightSpeed) / 2.0;	
			DifSpeed = TURN_FB_SIGN * (LeftSpeed - RightSpeed);			
			
			/*执行PID调控程序*/
			if (CarState == ST_BALANCE)		/* 只有正常直立时才跑速度环+转向环 */
			{
				/*速度环PID控制*/
				SpeedPID.Actual = AveSpeed;			
				PID_Update(&SpeedPID);				//调用封装好的函数，一步完成PID计算和更新
				AnglePID.Target = SpeedPID.Out;		
				
				/*转向环PID控制*/
				DifSpeedFilter += 0.5f * (DifSpeed - DifSpeedFilter);	/* 转向速度一阶低通：抑制编码器噪声/抖动，系数 0.5 可调(0.3更平滑/0.7更跟随) */
				TurnPID.Actual = DifSpeedFilter;			
				PID_Update(&TurnPID);				//调用封装好的函数，一步完成PID计算和更新
				DifPWM = (int16_t)(TurnPID.Out + TURN_FF * TurnPID.Target);	/* 转向环输出 + 死区前馈 */
				if (DifPWM > 50) DifPWM = 50; else if (DifPWM < -50) DifPWM = -50;	/* 限幅±25/轮，避免前馈+反馈叠加过大 */				

        }

    }


    /* 平衡中倒出 ERECT_START_ANG -> StopCar() 停机回 IDLE。
     * StopCar() 内部会做 PID_ResetAll()，所以躺倒后三个环是干净的；
     * 下一次蓝牙 "1" 时 StartErect() 还会先 Angle_Realign() 重对准一次倾角。 */
    if (CarState == ST_BALANCE && fabsf(Angle) > ERECT_START_ANG)
    {
        StopCar();
    }



    if (__HAL_TIM_GET_FLAG(&htim3, TIM_IT_UPDATE) != RESET)
    {

        if (__HAL_TIM_GET_FLAG(&htim3, TIM_IT_UPDATE) == SET)
        {
            TimerErrorFlag = 1;  // 标记错误

            __HAL_TIM_CLEAR_IT(&htim3, TIM_IT_UPDATE);
        }

        TimerCount = __HAL_TIM_GET_COUNTER(&htim3);
    }
}

