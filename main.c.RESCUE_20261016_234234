             * ÿ 10ms ����дһ�� 0���Ƿ���ʽд�����κ�����Ĳ��� PWM ���ᱻĨ�� */
            TB6612_setPWM(1, 0);
            TB6612_setPWM(2, 0);
        }
    }

    Count1 ++;				//�ƴμ���

    if (Count1 >= 50)		/* ===== 50ms �㣺�ٶȻ� + ת�� ===== */
    {
