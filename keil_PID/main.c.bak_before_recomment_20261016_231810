    TB6612_setPWM(1, 0);          /* ͣ��PWM=0��IN1/IN2 ͬ�� -> ������� */
    TB6612_setPWM(2, 0);
}

void StartErect(void)
{
    if (CarState != ST_IDLE)
    {
        return;                   /* �����л���ֱ���������ظ��� "1" */
    }

    /* ���ض�׼��ǣ��ٽ������������ɵ��� "1" �õ�������ʵ��ǣ�
     * ������Ư�������ݻ���ֵ��300ms ������ֻ����ѭ�����ܡ� */
    Angle_Realign();

    PID_ResetAll();
    ErectTime = 0;

    CarState = ST_ERECT;          /* ���һ�������ж��ӽǿ���ԭ�ӵ� */
}

