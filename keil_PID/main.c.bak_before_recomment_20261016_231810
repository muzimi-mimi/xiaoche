/* ==========================================================================
 * PID ״̬��λ / ����ض�׼
 *
 * PID_ResetAll()������������ Target / Out / ���� / ���ȫ�����㣬����"�ϴ�ֵ"
 *   ���²���Ϊ��ǰ������������������һ��΢�����һ�γ����
 *   �㵹(StopCar)����ͣ "0"��������ʱ���ᾭ�� StopCar��˳����ɾ���
 *   ��������ֻ�и��㸳ֵ��ȫ�ֱ�����ȡ�����Դ� 1ms �ж��ﰲȫ���ٵ��á�
 *
 * Angle_Realign()���ü��ٶȼư�������¶�׼һ��(��ֹʱ����)��
 *   �����˲� Alpha=0.001��ʱ�䳣��Լ 10s��ˤ��ʱ���ݱ��ͻ�� Angle ����
 *   ƫ����ʵֵ��Զ�������ض�׼���� "1" �������Ϊ |Angle| �󱨳ɺ�С��ֱ��
 *   ���� BALANCE ���� �������ţ�����ȴ��Ϊ�Ѿ�վ�����ˡ�
 *   �ں� 30 x 10ms = 300ms �� HAL_Delay��ֻ������ѭ�����ã�
 *   ���Բ��ܷŽ� 1ms �� HAL_TIM_PeriodElapsedCallback��
 * ========================================================================== */
void PID_ResetAll(void)
{
    PID_Init(&AnglePID);
    PID_Init(&SpeedPID);
    PID_Init(&TurnPID);

    /* Ԥ��"�ϴ�ֵ"����ֹ΢�����һ�γ�� */
    AnglePID.Actual  = Angle;
    AnglePID.Actual1 = Angle;
    AnglePID.Error0  = AnglePID.Target - AnglePID.Actual;
    AnglePID.Error1  = AnglePID.Error0;

    SpeedPID.Actual  = AveSpeed;
    SpeedPID.Actual1 = AveSpeed;
    TurnPID.Actual   = DifSpeed;
    TurnPID.Actual1  = DifSpeed;

    DifSpeedFilter = DifSpeed;
    DifPWM         = 0;
}

void Angle_Realign(void)
{
    int32_t  sum = 0;
    int      k;
    uint32_t itWasOn;

    /* �����ڼ����� TIM3 �жϣ��ж���Ҳ��� MPU6050(ͬһ�� I2C)��
     * �������ʻụ���ƻ�������ֻ�� DIER �� UIE λ������״̬����ԭ����
     * �����ϵ��ʼ���������е��ö����á� */
    itWasOn = (htim3.Instance->DIER & TIM_IT_UPDATE) ? 1u : 0u;
    __HAL_TIM_DISABLE_IT(&htim3, TIM_IT_UPDATE);

    for (k = 0; k < 30; k++)              /* 30 x 10ms = 300ms */
    {
        MPU6050_GetData(&AX, &AY, &AZ, &GX, &GY, &GZ);
        sum += (int32_t)(-atan2(AY, AZ) / 3.14159 * 180.0);
        HAL_Delay(10);
    }

    Angle = (float)sum / 30.0f + G;       /* ȡƽ�������������� */

    if (itWasOn)
    {
        __HAL_TIM_CLEAR_IT(&htim3, TIM_IT_UPDATE);
        __HAL_TIM_ENABLE_IT(&htim3, TIM_IT_UPDATE);
    }
}

/* ==========================================================================
 * ״̬��������StartErect() / StopCar()
 * StartErect() ֻ����ѭ�������������������ã�StopCar() ��ѭ���� 10ms �ж�
 * ������ã���ֻ����ֵ��PID ��λ�� GPIO д�����Դ��ж��ﰲȫ���á�
 * CarState һ�����д���ж�ֻ�ῴ��"��״̬"��"��״̬�Ѿ���"���֣�
