ADC_HandleTypeDef hadc1;

/* ADC1 init function */
void MX_ADC1_Init(void)
{

  /* USER CODE BEGIN ADC1_Init 0 */

  /* USER CODE END ADC1_Init 0 */

  ADC_ChannelConfTypeDef sConfig = {0};

  /* USER CODE BEGIN ADC1_Init 1 */

  /* USER CODE END ADC1_Init 1 */

  /** Common config
  */
  hadc1.Instance = ADC1;
  hadc1.Init.ScanConvMode = ADC_SCAN_DISABLE;
  hadc1.Init.ContinuousConvMode = DISABLE;
  hadc1.Init.DiscontinuousConvMode = DISABLE;
  hadc1.Init.ExternalTrigConv = ADC_SOFTWARE_START;
  hadc1.Init.DataAlign = ADC_DATAALIGN_RIGHT;
  hadc1.Init.NbrOfConversion = 1;
  if (HAL_ADC_Init(&hadc1) != HAL_OK)
  {
    Error_Handler();
  }

  /** Configure Regular Channel
  */
  sConfig.Channel = ADC_CHANNEL_4;
  sConfig.Rank = ADC_REGULAR_RANK_1;
  sConfig.SamplingTime = ADC_SAMPLETIME_1CYCLE_5;
  if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
  {
    Error_Handler();
  }
  /* USER CODE BEGIN ADC1_Init 2 */
  /* ---- ADC 自校准（原缺失，本次补上）-------------------------------------
   * STM32F1 的 ADC 每次上电后必须做一次自校准，否则内部电容组失配会留下固定的
   * 零点偏移。对 CCD 这种整幅动态范围只有十几级的信号，零点偏移是直接从阈值
   * 余量里扣掉的东西。
   * 必须在任何一次转换开始之前做，所以放在 MX_ADC1_Init() 末尾。
   * 厂商 HAL 版在同一位置有这一句（WHEELTEC 模块测试代码 adc.c:65）。
   * 校准内部有忙等待（几十个 ADCCLK），并用 HAL_GetTick() 做超时保护 ——
   * main() 在 MX_ADC1_Init() 之前已经调过 HAL_Init()（main.c:660 -> 680），
   * SysTick 时基已在跑，所以这里可以安全使用；此时也还没有开任何中断。 */
  if (HAL_ADCEx_Calibration_Start(&hadc1) != HAL_OK)
  {
    Error_Handler();
  }

  /* ---- 采样时间 1.5 周期 -> 41.5 周期 --------------------------------------
   * CubeMX 默认 ADC_SAMPLETIME_1CYCLE_5 = 1.5 周期。ADCCLK = PCLK2/6 = 12MHz
   * （main.c: RCC_ADCPCLK2_DIV6），1.5 周期只有 0.125us 采样窗口，对应 ST 建议
   * 的源阻抗上限不到 1k ohm，是个边界值。
   * 改成 41.5 周期（约 4.5us）：
   *   1) 源阻抗余量放到约 6.7k ohm；
   *   2) 采样窗拉长 6 倍，AO 上的宽带噪声被平均（白噪声约降 2.4 倍）。CCD 的
   *      对比度只有十几级，噪声是直接从阈值余量里扣的。
   * 放在 USER CODE 区，CubeMX 重新生成不会被改回 1.5 周期。
   * 代价：每像素约 9.5us（原约 5us），一帧读出 0.7ms -> 1.2ms；相对 40ms 曝光
   * 可以忽略，TIM3 中断预算也够（最坏单拍约 1.5ms / 10ms）。
   * 厂商取值参考：模块测试代码 Get_Adc() 用 239.5 周期（一帧 2.7ms）；平衡车
   * 巡线那份用 1.5 周期。这里取中间值，是精度与中断占用的折中。 */
  sConfig.SamplingTime = ADC_SAMPLETIME_41CYCLES_5;
  if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
  {
    Error_Handler();
  }
  /* USER CODE END ADC1_Init 2 */

}

