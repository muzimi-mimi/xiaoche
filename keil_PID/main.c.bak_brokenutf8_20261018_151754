void StartErect(void)
{
    if (CarState != ST_IDLE)
    {
        return;                   /* �������оͺ��ԣ��ظ��յ� "1" �������� */
    }

    /* ���ض�׼�Ƕȣ��ٽ�������ˤ���󻥲��˲�Ҫʮ�����������
     * �������ͻ���Ŵ�ĳ�ʼ�Ƕ�ȥ˦�֡�300ms ������ֻ����ѭ�����á� */
    Angle_Realign();

    PID_ResetAll();
